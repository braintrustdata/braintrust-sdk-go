# Disable automatic line ending conversion for Go files
*.go -text

# Mark VCR cassettes as generated so they collapse in diffs/PRs
**/testdata/cassettes/** linguist-generated=true

# Mark the generated OpenAPI client and its pinned spec as generated so they
# collapse in diffs/PRs
openapi/*.gen.go linguist-generated=true
openapi/spec.json linguist-generated=true
